# Copy to .env and adjust. Relative paths are resolved from this folder (costing/).

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
# true = restart automatically when backend code changes (development only)
APP_RELOAD=false

# --- Login (HTTP Basic, whole app) ---
# Leave APP_PASSWORD empty to disable login (local development only)
APP_USER=
APP_PASSWORD=

# --- Paths ---
DB_PATH=backend/data/costing.db
# Workbook loaded by "uv run backend/seed.py" when no file is given
SEED_WORKBOOK=Departmnetwise Expense Report 2026-27 (2).xlsx
# Built React app served at / (created by "npm run build" in frontend/, committed to git)
FRONTEND_DIST=backend/static
# Processed SAP data files (download history)
RUNS_DIR=backend/data/runs

# --- Frontend dev server (npm run dev) ---
VITE_DEV_PORT=5173

# --- Uploads ---
MAX_UPLOAD_MB=100

# --- CORS ---
# Comma-separated origins allowed to call the API from another host, e.g. http://192.168.1.20:5173
# Leave empty when the frontend is served by this server or through the Vite dev proxy.
CORS_ORIGINS=
# --- AI department check ---
# false = do not add the AI columns to the SAP result
AI_ENABLED=true
# Trained model (create it with: uv run backend/train_ai.py <history.csv>)
AI_MODEL_FILE=backend/data/ai/dept_model.joblib
AI_HISTORY_FILE=backend/data/ai/history.csv
# REVIEW = model disagrees with the assigned department and confidence is at least this (0.95 = fewer, surer flags)
AI_REVIEW_CONF=0.90
# WATCH = weaker disagreement, confidence at least this
AI_WATCH_CONF=0.60
