# Rendered by the nginx image at startup: ${COSTING_DOMAIN}, ${VOICE_DOMAIN} and ${BASE_PATH} come
# from docker-compose.yml (defaults: localhost / scm.localhost / /costing; server: set them in .env).
# This nginx owns host port 80, so it is also the edge for both domains:
#   ${COSTING_DOMAIN} -> costing container (this project)
#   ${VOICE_DOMAIN}   -> voice_call project's own nginx on host port 8082

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # default_server: plain IP access and unknown names land on the costing app
    listen 80 default_server;
    server_name ${COSTING_DOMAIN};

    # Keep in step with MAX_UPLOAD_MB (SAP workbook uploads)
    client_max_body_size 100m;
    # Relative Location headers, so redirects keep the port the browser used
    absolute_redirect off;

    # The app lives under ${BASE_PATH}/
    location = / {
        return 302 ${BASE_PATH}/;
    }

    location / {
        proxy_pass http://costing:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Large SAP files can take a while to process
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    server_name ${VOICE_DOMAIN};

    client_max_body_size 25m;

    location / {
        # host.docker.internal maps to the Docker host (extra_hosts in docker-compose.yml)
        proxy_pass http://host.docker.internal:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Voice call websockets stay open for the whole call
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
